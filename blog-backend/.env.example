# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/blogdb?schema=public"

PORT=5000

# Secret key required (x-api-key header) for create/update/delete endpoints
ADMIN_API_KEY="change-me-to-a-long-random-string"

# Frontend origin allowed in production (dev uses the Vite proxy, so CORS isn't needed)
CORS_ORIGIN="http://localhost:5173"
